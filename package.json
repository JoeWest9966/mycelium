{
  "name": "mycelium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Panel for hypha — a React client generated from the hub's OpenAPI contract",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript ../hypha/api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "openapi-typescript ../hypha/api/openapi.yaml -o /tmp/mycelium-schema.d.ts && diff -q /tmp/mycelium-schema.d.ts src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
