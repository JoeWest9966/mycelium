# When you have no nginx: one process serves the build and proxies the API.
# Copy to /etc/systemd/system/, adjust the paths, then:
#   systemctl daemon-reload && systemctl enable --now mycelium
[Unit]
Description=mycelium panel (static build + proxy to hyphad)
After=network-online.target hyphad.service
Wants=hyphad.service

[Service]
Type=simple
WorkingDirectory=/opt/mycelium-site
Environment=PORT=5524
Environment=DIST=/opt/mycelium-site/dist
Environment=HUB_HOST=127.0.0.1
Environment=HUB_PORT=5522
# Optional. Without it /api/warehouse/* answers 501 with instructions.
Environment=WAREHOUSE_URL=http://100.106.43.81:4790/p/new1/vq0f03/api
ExecStart=/usr/bin/node /opt/mycelium-site/deploy/proxy.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
